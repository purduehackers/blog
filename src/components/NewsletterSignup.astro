---
import Button from "./ph/Button.astro";
---

<section
  id="subscribe"
  aria-labelledby="subscribe-title"
  class="mx-auto w-full max-w-7xl scroll-mt-24 px-5 pb-14 font-main text-foreground sm:px-8 sm:pb-20 lg:px-10"
>
  <div
    class="grid gap-8 border-t border-border pt-10 md:grid-cols-[0.85fr_1.15fr] md:gap-14 md:pt-14 lg:gap-24"
  >
    <div>
      <h2
        id="subscribe-title"
        class="font-pixel text-3xl uppercase leading-tight sm:text-4xl"
      >
        Stay in the loop
      </h2>
      <p
        id="subscribe-description"
        class="mt-4 max-w-sm text-base leading-relaxed"
      >
        Get our monthly newsletter, full of things we're making and magic from
        Purdue Hackers.
      </p>
    </div>
    <form
      action="/api/subscribe"
      method="post"
      data-newsletter-form
      aria-describedby="subscribe-description"
      class="w-full"
    >
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="flex flex-col gap-2">
          <label for="subscriber-name" class="text-sm font-medium">Name</label>
          <input
            id="subscriber-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            maxlength="100"
            placeholder="Your name"
            class="newsletter-input min-w-0 w-full rounded-none border bg-card px-4 py-3 text-base text-card-foreground"
          />
        </div>
        <div class="flex flex-col gap-2">
          <label for="subscriber-email" class="text-sm font-medium">Email</label
          >
          <input
            id="subscriber-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
            placeholder="you@example.com"
            class="newsletter-input min-w-0 w-full rounded-none border bg-card px-4 py-3 text-base text-card-foreground"
          />
        </div>
      </div>
      <div hidden aria-hidden="true">
        <label for="subscriber-website">Website</label>
        <input
          id="subscriber-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <p class="mt-4 text-xs leading-relaxed">
        By subscribing, you agree to receive the Purdue Hackers newsletter.
      </p>
      <Button
        type="submit"
        variant="outline"
        size="lg"
        class="mt-5 !w-full !font-pixel !font-normal !tracking-normal disabled:cursor-wait sm:!w-auto"
        >Subscribe</Button
      >
      <p
        data-newsletter-status
        role="status"
        aria-live="polite"
        aria-atomic="true"
        class="mt-3 min-h-6 text-sm leading-relaxed"
      >
      </p>
      <noscript
        ><p class="mt-3 text-sm">
          Please enable JavaScript to subscribe to the newsletter.
        </p></noscript
      >
    </form>
  </div>
</section>

<style>
  .newsletter-input {
    border-color: var(--input);
  }

  .newsletter-input::placeholder {
    color: inherit;
    opacity: 0.5;
  }

  .newsletter-input:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-newsletter-form]")
    .forEach((form) => {
      const button = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      )!;
      const status = form.querySelector<HTMLParagraphElement>(
        "[data-newsletter-status]",
      )!;
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (button.disabled || !form.reportValidity()) return;
        button.disabled = true;
        button.textContent = "Subscribing…";
        form.setAttribute("aria-busy", "true");
        status.textContent = "";
        try {
          const fields = new FormData(form);
          const response = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name: fields.get("name"),
              email: fields.get("email"),
              website: fields.get("website"),
            }),
            signal: AbortSignal.timeout(40000),
          });
          const result = await response.json();
          if (!response.ok)
            throw new Error(
              result.message ||
                "We couldn't save your signup. Please try again.",
            );
          status.textContent = result.message;
          form.reset();
        } catch (error) {
          status.textContent =
            error instanceof Error && error.name === "Error"
              ? error.message
              : "We couldn't connect. Please try again in a moment.";
        } finally {
          button.disabled = false;
          button.textContent = "Subscribe";
          form.removeAttribute("aria-busy");
        }
      });
    });
</script>
