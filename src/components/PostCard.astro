---
import type { CollectionEntry } from "astro:content";
import AuthorGroup from "./AuthorGroup.astro";

interface Props {
  post: { slug: string; data: CollectionEntry<"blog">["data"] };
  type: "blog" | "vipNewsletter";
}

const { post, type } = Astro.props;
const { data } = post;
const isExternal = Boolean(data.externalUrl);
const href =
  data.externalUrl ??
  `/${type === "blog" ? "posts" : "vip-newsletter"}/${post.slug}`;
const date = data.pubDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<article class="post-card border-b border-border">
  <a
    href={href}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    class="group flex h-full flex-col px-5 py-7 text-foreground no-underline sm:px-8 sm:py-9 hover:bg-card focus-visible:relative focus-visible:z-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary motion-safe:transition-colors motion-safe:duration-150 motion-safe:ease-quint"
  >
    <time
      datetime={data.pubDate.toISOString()}
      class="font-main text-sm leading-relaxed"
    >
      {date}
    </time>
    <h2
      class="mt-4 font-pixel text-2xl uppercase leading-[1.12] sm:text-3xl [overflow-wrap:anywhere] group-hover:text-primary group-focus-visible:text-primary"
    >
      {data.title}
    </h2>
    <p class="mt-4 font-main text-base leading-relaxed">
      {data.description}
    </p>
    {
      (data.authors.length > 0 || isExternal) && (
        <div class="mt-auto pt-7">
          <AuthorGroup authors={data.authors} external={isExternal} />
        </div>
      )
    }
    {isExternal && <span class="sr-only">Opens in a new tab</span>}
  </a>
</article>
