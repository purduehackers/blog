---
import { parseMarkdownLink } from "lib/utils";
import Badge from "./ph/Badge.astro";
import AuthorAvatar from "./AuthorAvatar.astro";

interface Props {
  authors: string[];
  external?: boolean;
  size?: "sm" | "md";
}

const { authors, external = false, size = "sm" } = Astro.props;
const people = authors.map(parseMarkdownLink);
const names = new Intl.ListFormat("en", {
  style: "long",
  type: "conjunction",
}).format(people.map(({ author }) => author));
const avatarSize = size === "md" ? 36 : 30;
---

<div
  class="author-group flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2 font-main text-sm leading-relaxed"
>
  {
    people.length > 0 && (
      <div
        class:list={[
          "flex min-w-0 items-center gap-3",
          people.length > 2 &&
            "max-sm:flex-col max-sm:items-start max-sm:gap-2",
        ]}
      >
        <div class="flex shrink-0 items-center -space-x-2" aria-hidden="true">
          {people.map(({ author, avatarUrl }) => (
            <AuthorAvatar name={author} src={avatarUrl} size={avatarSize} />
          ))}
        </div>
        <span class="min-w-0 [overflow-wrap:anywhere]">{names}</span>
      </div>
    )
  }
  {
    external && (
      <Badge
        color="purple"
        class="shrink-0 !text-xs !normal-case !tracking-normal dark:bg-ph-pink dark:text-ph-black"
      >
        External post
      </Badge>
    )
  }
</div>
