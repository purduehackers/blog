---
import { getCollection } from "astro:content";

import BaseHead from "components/BaseHead.astro";
import BlogMarquee from "components/BlogMarquee.astro";
import Button from "components/ph/Button.astro";
import Footer from "components/Footer.astro";
import PostCard from "components/PostCard.astro";
import Nav from "components/Nav.astro";

import { SITE_TITLE } from "../../consts";

const coll = await getCollection(
  "blog",
  ({ data }) => data.type === "vip-newsletter",
);
const posts = coll.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description="All the newsletters we send to 70+ alumni, faculty, and sponsors."
      image="/og/vip-newsletter.png"
    />
  </head>
  <body class="bg-background text-foreground">
    <Nav />
    <div class="flex min-h-screen flex-col">
      <header id="hero-sentinel" class="publication-masthead bg-grid-animated">
        <div
          class="mx-auto flex w-full max-w-7xl flex-col items-start justify-between gap-6 px-5 pb-9 pt-24 sm:px-8 sm:pb-11 sm:pt-28 lg:flex-row lg:items-end"
        >
          <div class="min-w-0">
            <h1
              class="font-pixel text-3xl uppercase leading-[1.08] [overflow-wrap:anywhere] sm:text-5xl dark:text-ph-yellow"
            >
              VIP <span class="text-primary">Newsletters</span>
            </h1>
            <p
              class="mt-4 max-w-xl font-main text-base leading-relaxed sm:text-lg"
            >
              The monthly email we send to folks we want to stay in touch with.
            </p>
          </div>
          <Button
            href="#subscribe"
            variant="outline"
            size="md"
            class="!font-pixel !font-normal !tracking-normal"
            >Subscribe to the newsletter</Button
          >
        </div>
      </header>
      <BlogMarquee />
      <main class="mx-auto w-full max-w-7xl flex-1 pb-16 sm:pb-24">
        <section
          aria-label="Newsletter archive"
          class="newsletter-grid grid md:grid-cols-2"
        >
          {posts.map((post) => <PostCard post={post} type="vipNewsletter" />)}
        </section>
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  @media (min-width: 768px) {
    .newsletter-grid > :global(:nth-child(odd)) {
      border-right: 1px solid var(--border);
    }
  }
</style>
