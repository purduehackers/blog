---
import BaseHead from "../../components/BaseHead.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { validId } from "../../lib/admin/campaigns";
import { read } from "../../lib/admin/store";
import type { ImportedPage } from "../../lib/admin/notion";
export const prerender = false;
const id = Astro.params.id || "";
const page = validId(id) ? await read<ImportedPage>(`edition:${id}`) : null;
if (!page?.publishedAt)
  return new Response("Edition not found", { status: 404 });
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=60");
---

<!doctype html>
<html lang="en">
  <head
    ><BaseHead
      title={`${page.title} | Purdue Hackers`}
      description="The Purdue Hackers newsletter"
    /></head
  >
  <body>
    <Nav />
    <main class="edition">
      <a class="back" href="/newsletter">&lt;&lt; All newsletters</a>
      <p class="eyebrow">Purdue Hackers / Newsletter</p>
      <h1>{page.title}</h1>
      <p class="date">
        <time datetime={page.publishedAt}
          >{
            new Date(page.publishedAt).toLocaleDateString("en-US", {
              dateStyle: "long",
              timeZone: "America/Indiana/Indianapolis",
            })
          }</time>
      </p>
      <article set:html={page.html} />
    </main>
    <Footer />
  </body>
</html>
<style>
  .edition {
    max-width: 720px;
    margin: auto;
    padding: 100px 24px 64px;
  }
  .back,
  .eyebrow {
    font-family: PixelHackers, monospace;
    font-size: 13px;
  }
  .back {
    text-decoration: underline;
  }
  .eyebrow {
    margin-top: 48px;
    color: #9333ea;
  }
  h1 {
    font-size: clamp(32px, 6vw, 52px);
    line-height: 1.12;
    margin: 16px 0;
  }
  .date {
    opacity: 0.65;
    margin-bottom: 40px;
  }
  article {
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  article :global(h2) {
    font-size: 28px;
  }
  article :global(h3) {
    font-size: 23px;
  }
  article :global(h4) {
    font-size: 20px;
  }
  article :global(ul) {
    list-style: disc;
    padding-left: 24px;
  }
  article :global(ol) {
    list-style: decimal;
    padding-left: 24px;
  }
  article :global(blockquote),
  article :global(pre) {
    color: #241632;
  }
  article :global(table) {
    display: block;
    overflow-x: auto;
  }
</style>
