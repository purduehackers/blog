---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Newsletter rating | Purdue Hackers" description="Rate this newsletter." /></head>
  <body><Nav /><main style="max-width:640px;margin:100px auto;padding:24px">
    <h1>Newsletter rating</h1>
    <p id="rating-status" role="status" style="margin:24px 0">Saving your rating…</p>
    <button id="retry" hidden style="text-decoration:underline">Try again</button>
    <noscript>Enable JavaScript to save your rating automatically.</noscript>
    <p><a id="edition-link" href="/">Back to the blog</a></p>
  </main></body>
</html>
<script>
  const params = new URLSearchParams(location.search);
  const status = document.querySelector<HTMLElement>("#rating-status")!;
  const retry = document.querySelector<HTMLButtonElement>("#retry")!;
  const edition = params.get("edition");
  const score = Number(params.get("score"));
  async function save() {
    retry.hidden = true;
    if (!edition || ![1, 3, 5].includes(score)) {
      status.textContent = "This rating link is invalid. Please use a link in the newsletter.";
      return;
    }
    try {
      const response = await fetch("/api/rate", { method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ edition, score, token: params.get("token") }) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.message);
      status.textContent = `${"🔥".repeat(score)} Thanks! Your rating has been saved.`;
      const link = document.querySelector<HTMLAnchorElement>("#edition-link")!;
      link.href = `/posts/${encodeURIComponent(edition)}`;
      link.textContent = "Back to the newsletter";
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Couldn't save your rating.";
      retry.hidden = false;
    }
  }
  retry.addEventListener("click", save);
  void save();
</script>
