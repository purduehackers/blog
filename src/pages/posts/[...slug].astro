---
import { trackedLinks } from "../../lib/admin/clicks";
import { getCollection } from "astro:content";
import BlogPost from "layouts/BlogPost.astro";
import components from "lib/components";
import { validId } from "../../lib/admin/campaigns";
import { getEdition } from "../../lib/admin/store";
import { imageLayout } from "../../lib/admin/image-layout";
import { newsletterMediaUrls } from "../../lib/admin/media-urls";
import "../../styles/notion-images.css";
export const prerender = false;
const slug = Astro.params.slug || "";
const posts = await getCollection("blog", ({ data }) => data.type === "blog");
const post = posts.find((entry) => entry.slug === slug);
const page = !post && validId(slug) ? await getEdition(slug) : null;
if (!post && !page?.publishedAt)
  return new Response("Post not found", { status: 404 });
const data = post?.data ?? {
  title: page!.title,
  description: "News, projects, and what’s coming up at Purdue Hackers.",
  pubDate: new Date(page!.publishedAt!),
  authors: [],
  type: "blog" as const,
};
const Content =
  post && !post.data.externalUrl ? (await post.render()).Content : null;
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=60");
---

<BlogPost {...data} slug={slug} image={page ? "/og/blog.png" : undefined}>
  {Content && <Content components={components} />}
  {
    page && (
      <div
        class:list={[
          "imported-post",
          page.importMode !== "notion-layout" && "notion-content",
        ]}
        set:html={imageLayout(
          trackedLinks(newsletterMediaUrls(page.html), page.id, "web"),
          true,
        )}
      />
    )
  }
  {
    page && (
      <section aria-label="Rate this newsletter" style="margin-top:32px">
        <p>How was this newsletter?</p>
        <div style="margin:16px 0">
          {[1, 3, 5].map((score) => (
            <div style="margin:8px 0">
              <a
                style="text-decoration:underline"
                href={`/rate?edition=${page.id}&score=${score}`}
              >
                {"🔥".repeat(score)}{" "}
                {score === 1
                  ? "Meh"
                  : score === 3
                    ? "Solid issue"
                    : "This was gold!"}
              </a>
            </div>
          ))}
        </div>
      </section>
    )
  }
</BlogPost>

<style>
  .imported-post {
    width: 100%;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .imported-post :global(h2) {
    font-size: 28px;
  }
  .imported-post :global(h3) {
    font-size: 23px;
  }
  .imported-post :global(h4) {
    font-size: 20px;
  }
  .imported-post :global(ul) {
    list-style: disc;
    padding-left: 24px;
  }
  .imported-post :global(ol) {
    list-style: decimal;
    padding-left: 24px;
  }
  .imported-post :global(blockquote),
  .imported-post :global(pre) {
    color: #241632;
  }
  .imported-post :global(table:not(.notion-gallery)) {
    display: block;
    overflow-x: auto;
  }
</style>

<style>
  @media (max-width: 600px) {
    .imported-post :global(.notion-columns),
    .imported-post :global(.notion-columns tbody),
    .imported-post :global(.notion-columns tr),
    .imported-post :global(.notion-column) {
      display: block !important;
      width: 100% !important;
      box-sizing: border-box;
    }
  }
  .imported-post :global([data-notion-layout] img) {
    max-width: 100%;
    height: auto;
  }
  .imported-post :global(table.notion-columns) {
    display: table;
    overflow: visible;
  }
</style>
