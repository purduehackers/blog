---
import { loadBlogPosts } from "../lib/blog-posts";
export const prerender = false;

import BaseHead from "components/BaseHead.astro";
import BlogMarquee from "components/BlogMarquee.astro";
import Button from "components/ph/Button.astro";
import FeaturedPost from "components/FeaturedPost.astro";
import Footer from "components/Footer.astro";
import Nav from "components/Nav.astro";
import PostCard from "components/PostCard.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const { posts, unavailable } = await loadBlogPosts();
const [featuredPost, ...otherPosts] = posts;
Astro.response.headers.set(
  "Cache-Control",
  unavailable ? "no-store" : "public, max-age=60, s-maxage=60",
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image="/og/blog.png"
    />
  </head>
  <body class="bg-background text-foreground">
    <Nav />
    <div class="flex min-h-screen flex-col">
      <header id="hero-sentinel" class="publication-masthead bg-grid-animated">
        <div
          class="mx-auto flex w-full max-w-7xl flex-col items-start justify-between gap-8 px-5 pb-14 pt-28 sm:px-8 sm:pb-20 sm:pt-36 lg:flex-row lg:items-end"
        >
          <div>
            <h1
              class="max-w-4xl font-pixel text-5xl uppercase leading-[0.98] sm:text-7xl lg:text-8xl dark:text-ph-yellow"
            >
              Purdue Hackers<br /><span class="text-primary">Blog</span>
            </h1>
            <p
              class="mt-6 max-w-lg font-main text-lg leading-relaxed sm:text-xl"
            >
              Where we share our magic with the world.
            </p>
          </div>
          <Button
            href="#subscribe"
            variant="outline"
            size="md"
            class="!font-pixel !font-normal !tracking-normal"
            >Subscribe to the newsletter</Button
          >
        </div>
      </header>
      <BlogMarquee />
      <main class="mx-auto w-full max-w-7xl flex-1 pb-16 sm:pb-24">
        {
          unavailable && (
            <p
              role="status"
              class="border-b border-border px-5 py-4 font-main text-sm leading-relaxed sm:px-8"
            >
              Recent posts are temporarily unavailable. Please try again
              shortly.
            </p>
          )
        }
        {featuredPost && <FeaturedPost post={featuredPost} />}
        {
          otherPosts.length > 0 && (
            <section
              aria-label="More posts"
              class="post-grid grid md:grid-cols-2"
            >
              {otherPosts.map((post) => (
                <PostCard post={post} type="blog" />
              ))}
            </section>
          )
        }
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  @media (min-width: 768px) {
    .post-grid > :global(:nth-child(odd)) {
      border-right: 1px solid var(--border);
    }
  }
</style>
