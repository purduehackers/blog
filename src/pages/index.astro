---
import { loadBlogPosts } from "../lib/blog-posts";
export const prerender = false;

import BaseHead from "components/BaseHead.astro";
import Footer from "components/Footer.astro";
import Nav from "components/Nav.astro";
import PostCard from "components/PostCard.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const { posts, unavailable } = await loadBlogPosts();
Astro.response.headers.set(
  "Cache-Control",
  unavailable ? "no-store" : "public, max-age=60, s-maxage=60",
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image="/og/blog.png"
    />
  </head>
  <body>
    <Nav />
    <div class="min-h-screen flex flex-col">
      <header
        id="hero-sentinel"
        class="relative overflow-hidden bg-grid-animated [--grid-size:26px] [--grid-color:rgba(0,0,0,0.06)] dark:[--grid-color:rgba(255,255,255,0.08)] border-b border-black/10 dark:border-white/10"
      >
        <div
          class="relative z-10 text-center px-4 pt-24 pb-16 sm:pt-32 sm:pb-24 flex flex-col gap-y-5 items-center"
        >
          <h1
            class="font-pixel uppercase text-5xl sm:text-7xl md:text-8xl leading-[1.05] dark:text-yellow"
          >
            Purdue Hackers <span class="text-amber-500 dark:text-purple-400"
              >Blog</span
            >
          </h1>
          <p
            class="font-mono text-sm sm:text-base md:text-lg text-black/70 dark:text-white/70 max-w-xl"
          >
            <span class="font-pixel">{"> "}</span>
            Where we share our magic with the world.
          </p>
          <a
            href="#subscribe"
            class="font-pixel uppercase rounded-sm bg-purple-700 text-white px-5 py-3 hover:bg-purple-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-700 dark:focus-visible:outline-purple-400"
            >Subscribe to the newsletter</a
          >
        </div>
      </header>
      <div
        class="w-full max-w-3xl flex flex-col gap-4 py-10 sm:py-16 px-5 sm:px-8 mx-auto"
      >
        {
          unavailable && (
            <p role="status">
              Recent posts are temporarily unavailable. Please try again
              shortly.
            </p>
          )
        }
        {posts.map((post) => <PostCard post={post} type="blog" />)}
      </div>
      <Footer />
    </div>
  </body>
</html>
