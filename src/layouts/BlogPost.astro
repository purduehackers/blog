---
import type { CollectionEntry } from "astro:content";
import BaseHead from "components/BaseHead.astro";
import BlogMarquee from "components/BlogMarquee.astro";
import Header from "components/Header.astro";
import Nav from "components/Nav.astro";
import Footer from "components/Footer.astro";
import Icon from "components/ph/Icon.astro";
import { getOgImage } from "lib/utils";
import "styles/article.css";

type Props = CollectionEntry<"blog">["data"] & {
  slug: string;
  image?: string | undefined;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  authors,
  externalUrl,
  type,
  slug,
  image,
  coverImage,
  coverImageAlt,
} = Astro.props;
const isExternal = !!externalUrl;
const ogImage = image ?? getOgImage({ type, slug });
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} | Purdue Hackers`}
      description={description}
      image={ogImage}
      canonical={externalUrl}
    />
    {
      externalUrl && (
        <meta http-equiv="refresh" content={`3;url=${externalUrl}`} />
      )
    }
  </head>
  <body class="bg-background text-foreground">
    <Nav />
    <main class="article-page" aria-labelledby="post-title">
      <div class="article-masthead publication-masthead bg-grid-animated">
        <div class="article-shell">
          <Header
            authors={authors}
            pubDate={pubDate}
            updatedDate={isExternal ? undefined : updatedDate}
            title={title}
            description={description}
            external={isExternal}
          />
        </div>
      </div>
      <BlogMarquee />
      <div class="article-shell article-layout" data-article-layout>
        {
          isExternal ? (
            <section class="article-external">
              <p>
                This story lives on the author’s website. Taking you there now.
              </p>
              <a class="article-original" href={externalUrl}>
                Read the original post
              </a>
            </section>
          ) : (
            <>
              <aside class="article-contents" data-article-contents hidden>
                <details data-article-contents-toggle>
                  <summary id="article-contents-title">
                    <span>On this page</span>
                    <Icon name="angle-down" />
                  </summary>
                  <nav aria-labelledby="article-contents-title">
                    <ol data-article-contents-list />
                  </nav>
                </details>
              </aside>
              <div class="article-main">
                {coverImage && (
                  <figure class="article-cover">
                    <a
                      href={coverImage}
                      data-fancybox="post"
                      data-caption={coverImageAlt}
                      aria-label="Enlarge cover image"
                    >
                      <img
                        src={coverImage}
                        alt={coverImageAlt ?? ""}
                        fetchpriority="high"
                        decoding="async"
                      />
                    </a>
                  </figure>
                )}
                <article class="blog-prose" data-article-body>
                  <slot />
                </article>
                <div class="article-end">
                  <a
                    class="article-back"
                    href={type === "vip-newsletter" ? "/vip-newsletter" : "/"}
                  >
                    <Icon name="arrow-left" />
                    <span>
                      {type === "vip-newsletter"
                        ? "Back to all newsletters"
                        : "Back to all posts"}
                    </span>
                  </a>
                </div>
              </div>
            </>
          )
        }
      </div>
    </main>
    <Footer />
    <script>
      import { Fancybox } from "@fancyapps/ui";
      import "@fancyapps/ui/dist/fancybox/fancybox.css";
      import { initializeArticle } from "../scripts/article";

      Fancybox.bind('[data-fancybox="post"]');
      initializeArticle();
    </script>
  </body>
</html>
