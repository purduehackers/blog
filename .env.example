# Server-only Notion integration token. Set this in Vercel too.
NOTION_API_KEY=
NOTION_DATABASE_ID=346181f3b6ed800586cfdd7c42d0ac65
# Optional: required only if the database contains multiple data sources.
NOTION_DATA_SOURCE_ID=
# Exact Notion column names (Name must be title/rich text; Email must be email/rich text).
NOTION_NAME_PROPERTY=Name
NOTION_EMAIL_PROPERTY=Email

# Newsletter admin: all values below are server-only.
NEWSLETTER_SITE_URL=https://blog.purduehackers.com
PH_ID_CLIENT_ID=
PH_ID_CLIENT_SECRET=
# ID's app-creation UI defaults to client_secret_basic.
PH_ID_TOKEN_AUTH_METHOD=client_secret_basic
# ID app: authorization_code, PKCE S256, scopes openid/profile/roles.
# Register NEWSLETTER_SITE_URL + /admin/callback as its redirect URI.
PH_ID_REQUIRED_ROLE=organizer

# Turso's Vercel Marketplace integration supplies these server-only variables.
BLOG_STORAGE_TURSO_DATABASE_URL=
BLOG_STORAGE_TURSO_AUTH_TOKEN=
# Unprefixed TURSO_DATABASE_URL / TURSO_AUTH_TOKEN are also supported.
# Use a separate Turso database for development/preview environments.
# Local-only option: BLOG_STORAGE_TURSO_DATABASE_URL=file:./newsletter.local.db (no token needed).
# Generate once: openssl rand -base64 32. Keep the same key for the stored data.
NEWSLETTER_ENCRYPTION_KEY=

# Microsoft Entra public-client application; delegated Mail.Send + User.Read + Calendars.ReadWrite.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_SENDER_EMAIL=phackers@purdue.edu
